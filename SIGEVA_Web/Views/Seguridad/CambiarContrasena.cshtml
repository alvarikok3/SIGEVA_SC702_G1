@model CambiarContrasenaModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="sg-card" style="max-width:500px; margin:0 auto;">
    <div class="card-body">
        <h5 class="fw-semibold mb-4">Cambiar contraseña</h5>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-@ViewBag.Tipo text-center">@ViewBag.Mensaje</div>
        }

        <form asp-action="CambiarContrasena" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold" asp-for="ContrasenaActual">Contraseña actual</label>
                <input asp-for="ContrasenaActual" type="password" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" asp-for="ContrasenaNueva">Nueva contraseña</label>
                <input asp-for="ContrasenaNueva" type="password" class="form-control" required minlength="5" />
                <small class="text-muted">Mínimo 5 caracteres.</small>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold" asp-for="ConfirmarContrasena">Confirmar nueva contraseña</label>
                <input asp-for="ConfirmarContrasena" type="password" class="form-control" required minlength="5" />
            </div>
            <button type="submit" class="btn btn-sg w-100">Actualizar contraseña</button>
        </form>
    </div>
</div>
