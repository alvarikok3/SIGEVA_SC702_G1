@using SIGEVA_Web.Models
@model List<ServicioMedicoModel>

@{
    ViewData["Title"] = "Catálogo de servicios médicos";

    var categorias = ViewBag.Categorias
        as List<CategoriaServicioModel>
        ?? new List<CategoriaServicioModel>();

    var busqueda = ViewBag.Busqueda as string ?? "";

    int? idCategoria = ViewBag.IdCategoria as int?;
}

<div class="welcome-banner">
    <h2>Catálogo de servicios médicos</h2>
    <span class="welcome-badge">Clínica EVA</span>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">

        <h5 class="mb-3">
            <i class="bi bi-search"></i>
            Buscar servicios médicos
        </h5>

        <form asp-controller="ServicioMedico"
              asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="busqueda" class="form-label">
                        Nombre del servicio
                    </label>

                    <input type="text"
                           id="busqueda"
                           name="busqueda"
                           value="@busqueda"
                           maxlength="150"
                           class="form-control"
                           placeholder="Ejemplo: fertilidad, FIV..." />
                </div>

                <div class="col-md-4">
                    <label for="idCategoria" class="form-label">
                        Categoría
                    </label>

                    <select id="idCategoria"
                            name="idCategoria"
                            class="form-select">

                        <option value="">Todas las categorías</option>

                        @foreach (var categoria in categorias)
                        {
                            if (idCategoria == categoria.IdCategoria)
                            {
                                <option value="@categoria.IdCategoria"
                                        selected>
                                    @categoria.Nombre
                                </option>
                            }
                            else
                            {
                                <option value="@categoria.IdCategoria">
                                    @categoria.Nombre
                                </option>
                            }
                        }

                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-sg">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>

                    <a asp-controller="ServicioMedico"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>

                </div>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Servicios disponibles</h5>

    <span class="badge bg-secondary">
        @(Model?.Count ?? 0) resultado(s)
    </span>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3">

        @foreach (var servicio in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">

                        <div class="mb-3">
                            <i class="bi bi-heart-pulse fs-3"></i>
                        </div>

                        <h5 class="card-title">
                            @servicio.Nombre
                        </h5>

                        <span class="badge bg-light text-dark border mb-3">
                            @servicio.Categoria
                        </span>

                        <p class="card-text text-muted">
                            @(string.IsNullOrWhiteSpace(servicio.Descripcion)
                                ? "Descripción no disponible."
                                : servicio.Descripcion)
                        </p>

                    </div>

                    <div class="card-footer bg-transparent border-0 pb-3">
                        <span class="text-success small">
                            <i class="bi bi-check-circle"></i>
                            Servicio disponible
                        </span>
                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="alert alert-info text-center py-4">

        <i class="bi bi-search fs-3 d-block mb-2"></i>

        <h5>No se encontraron servicios médicos</h5>

        <p class="mb-0">
            No existen servicios que coincidan con la búsqueda.
            Intentá con otro nombre o categoría.
        </p>

    </div>
}
