@model SIGEVA_Web.Models.CitaModel

@{
    ViewData["Title"] = "Editar cita médica";

    var pacientes = ViewBag.Pacientes
        as List<SIGEVA_Web.Models.PacienteModel> ?? new();

    var medicos = ViewBag.Medicos
        as List<SIGEVA_Web.Models.UsuarioListaModel> ?? new();
}

<div class="sg-card">
    <div class="card-body">

        <h4 class="mb-4">Editar cita médica</h4>

        @if (ViewBag.Mensaje != null)
        {
            var tipo = ViewBag.Tipo ?? "danger";

            <div class="alert alert-@tipo" role="alert">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-controller="Cita"
              asp-action="Editar"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="IdCita" type="hidden" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="IdPaciente"
                           class="form-label">
                        Paciente
                    </label>

                    <select asp-for="IdPaciente"
                            class="form-select"
                            required>

                        <option value="">Seleccione un paciente</option>

                        @foreach (var paciente in pacientes)
                        {
                            <option value="@paciente.IdPaciente">
                                @paciente.Identificacion - @paciente.Nombre
                            </option>
                        }
                    </select>

                    <span asp-validation-for="IdPaciente"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="IdUsuario"
                           class="form-label">
                        Médico
                    </label>

                    <select asp-for="IdUsuario"
                            class="form-select"
                            required>

                        <option value="">Seleccione un médico</option>

                        @foreach (var medico in medicos)
                        {
                            <option value="@medico.IdUsuario">
                                @medico.Nombre
                            </option>
                        }
                    </select>

                    <span asp-validation-for="IdUsuario"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaHora"
                           class="form-label">
                        Fecha y hora
                    </label>

                    <input asp-for="FechaHora"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control"
                           required />

                    <span asp-validation-for="FechaHora"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Observaciones"
                           class="form-label">
                        Observaciones
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="4"
                              maxlength="500"></textarea>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit" class="btn btn-sg">
                    <i class="bi bi-check-circle me-1"></i>
                    Guardar cambios
                </button>

                <a asp-controller="Cita"
                   asp-action="Index"
                   class="btn btn-sg-outline">
                    Cancelar
                </a>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
