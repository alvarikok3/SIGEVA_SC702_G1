@model CitaModel
@{
    ViewData["Title"] = "Registrar cita";
    var pacientes = ViewBag.Pacientes as List<PacienteModel> ?? new();
    var medicos = ViewBag.Medicos as List<UsuarioListaModel> ?? new();
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Index" class="btn btn-sg-outline">Volver</a>
</div>

<div class="sg-card">
    <div class="card-body">
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-@ViewBag.Tipo text-center">@ViewBag.Mensaje</div>
        }

        <form asp-action="Registrar" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="IdPaciente">Paciente</label>
                    <select asp-for="IdPaciente" class="form-select" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var p in pacientes)
                        {
                            <option value="@p.IdPaciente">@p.Identificacion - @p.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="IdUsuario">Médico / responsable</label>
                    <select asp-for="IdUsuario" class="form-select" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var m in medicos)
                        {
                            <option value="@m.IdUsuario">@m.Nombre (@m.NombreRol)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="FechaHora">Fecha y hora</label>
                    <input type="datetime-local" name="FechaHora" class="form-control" required
                           value="@Model.FechaHora.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="EstadoCita">Estado</label>
                    <select asp-for="EstadoCita" class="form-select" required>
                        <option value="Programada">Programada</option>
                        <option value="Confirmada">Confirmada</option>
                        <option value="Cancelada">Cancelada</option>
                        <option value="Atendida">Atendida</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" asp-for="Observaciones">Observaciones</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-sg">Guardar</button>
            </div>
        </form>
    </div>
</div>
