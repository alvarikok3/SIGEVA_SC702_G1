@using Microsoft.AspNetCore.Http
@model List<CitaModel>

@{
    ViewData["Title"] = "Citas médicas";

    var esAdministrador = Context.Session.GetInt32("IdRol") == 1;
    var esMedico = Context.Session.GetInt32("IdRol") == 3;

    var pacientes = ViewBag.Pacientes as List<PacienteModel> ?? new();
    var medicos = ViewBag.Medicos as List<UsuarioListaModel> ?? new();

    DateTime? fechaFiltro = ViewBag.FechaFiltro;
    int? idUsuarioFiltro = ViewBag.IdUsuarioFiltro;
    int? idPacienteFiltro = ViewBag.IdPacienteFiltro;

    var hayFiltros = fechaFiltro.HasValue
        || idUsuarioFiltro.HasValue
        || idPacienteFiltro.HasValue;
}

@* MENSAJES DEL SISTEMA *@

@if (TempData["Mensaje"] != null)
{
    var tipo = TempData["Tipo"]?.ToString() ?? "info";

    <div class="alert alert-@tipo alert-dismissible fade show"
         role="alert">

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@* BOTONES SUPERIORES *@

<div class="d-flex justify-content-end mb-3 gap-2 flex-wrap">

    @if (esAdministrador)
    {
        <a asp-action="Reporte" class="btn btn-sg-outline">
            <i class="bi bi-file-earmark-bar-graph me-1"></i>
            Reporte
        </a>
    }

    <a asp-action="Calendario" class="btn btn-sg-outline">
        <i class="bi bi-calendar3 me-1"></i>
        Calendario
    </a>

    @if (esAdministrador)
    {
        <a asp-controller="Cita"
           asp-action="ProgramarCitaAdministrativa"
           class="btn btn-sg">
            <i class="bi bi-calendar-plus me-1"></i>
            Programar cita médica
        </a>
    }
</div>

@* HU-CIT-003 - FILTROS *@

@if (esAdministrador || esMedico)
{
    <div class="sg-card mb-3">
        <div class="card-body">

            <h5 class="mb-3">
                <i class="bi bi-funnel me-2"></i>
                Filtrar citas médicas
            </h5>

            <form asp-controller="Cita"
                  asp-action="ConsultarCitasFiltradas"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Fecha
                        </label>

                        <input type="date"
                               name="fecha"
                               class="form-control"
                               value="@(fechaFiltro?.ToString("yyyy-MM-dd"))" />
                    </div>

                    @if (esAdministrador)
                    {
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">
                                Médico / responsable
                            </label>

                            <select name="idUsuario" class="form-select">
                                <option value="">Todos los médicos</option>

                                @foreach (var medico in medicos)
                                {
                                    if (idUsuarioFiltro == medico.IdUsuario)
                                    {
                                        <option value="@medico.IdUsuario" selected>
                                            @medico.Nombre
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@medico.IdUsuario">
                                            @medico.Nombre
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Paciente
                        </label>

                        <select name="idPaciente" class="form-select">
                            <option value="">Todos los pacientes</option>

                            @foreach (var paciente in pacientes)
                            {
                                if (idPacienteFiltro == paciente.IdPaciente)
                                {
                                    <option value="@paciente.IdPaciente" selected>
                                        @paciente.Identificacion - @paciente.Nombre
                                    </option>
                                }
                                else
                                {
                                    <option value="@paciente.IdPaciente">
                                        @paciente.Identificacion - @paciente.Nombre
                                    </option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3">

                    <button type="submit" class="btn btn-sg">
                        <i class="bi bi-search me-1"></i>
                        Buscar citas
                    </button>

                    <a asp-controller="Cita"
                       asp-action="ConsultarCitasFiltradas"
                       class="btn btn-sg-outline">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Limpiar filtros
                    </a>

                </div>
            </form>
        </div>
    </div>
}

@* LISTADO DE CITAS *@

@if (Model != null && Model.Count > 0)
{
    <div class="sg-card">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-3">Fecha</th>
                            <th>Paciente</th>
                            <th>Médico</th>
                            <th>Estado</th>

                            @if (esAdministrador)
                            {
                                <th class="pe-3 text-end">Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @item.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>@item.NombrePaciente</td>

                                <td>@item.NombreMedico</td>

                                <td>
                                    <span class="badge text-bg-light border">
                                        @item.EstadoCita
                                    </span>
                                </td>

                                @if (esAdministrador)
                                {
                                    <td class="pe-3 text-end">

                                        <a asp-action="Editar"
                                           asp-route-id="@item.IdCita"
                                           class="btn btn-sm btn-sg-outline">
                                            Editar
                                        </a>

                                        @if (item.EstadoCita == "Programada")
                                        {
                                            <form asp-controller="Cita"
                                                  asp-action="CambiarEstado"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdCita" />

                                                <input type="hidden"
                                                       name="estado"
                                                       value="Confirmada" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Confirmar
                                                </button>
                                            </form>
                                        }

                                        @if (item.EstadoCita == "Programada" ||
                                             item.EstadoCita == "Confirmada")
                                        {
                                            <form asp-controller="Cita"
                                                  asp-action="CambiarEstado"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de cancelar esta cita médica? Esta acción liberará el horario del médico.');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdCita" />

                                                <input type="hidden"
                                                       name="estado"
                                                       value="Cancelada" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Cancelar
                                                </button>
                                            </form>
                                        }

                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}
else
{
    <div class="sg-card">
        <div class="card-body text-center text-muted py-5">

            <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>

            @if (hayFiltros)
            {
                <h5>No se encontraron citas</h5>

                <p class="mb-0">
                    No existen citas médicas que coincidan
                    con los filtros seleccionados.
                </p>
            }
            else
            {
                <h5>No hay citas registradas</h5>

                <p class="mb-0">
                    Actualmente no existen citas médicas
                    para mostrar.
                </p>
            }

        </div>
    </div>
}
