@model ReportePacientesFiltroModel
@{
    ViewData["Title"] = "Reporte de pacientes";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Index" class="btn btn-sg-outline">Volver al listado</a>
</div>

<div class="sg-card mb-4">
    <div class="card-body">
        <h6 class="fw-semibold mb-3">Filtros</h6>
        <form asp-action="Reporte" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Buscar por nombre..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" asp-for="Estado">Estado</label>
                    <select asp-for="Estado" class="form-select">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-sg">
                    <i class="bi bi-search me-1"></i> Generar reporte
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Resultados.Count > 0)
{
    <div class="sg-card">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                <span class="fw-semibold">@Model.Resultados.Count paciente(s) encontrado(s)</span>
                <span class="fw-semibold">
                    Activos: @Model.Resultados.Count(p => p.Estado) &nbsp;|&nbsp;
                    Inactivos: @Model.Resultados.Count(p => !p.Estado)
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Nombre</th>
                            <th>Identificación</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Fecha Nacimiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Resultados)
                        {
                            <tr>
                                <td class="ps-3"><strong>@item.Nombre</strong></td>
                                <td>@item.Identificacion</td>
                                <td>@item.Correo</td>
                                <td>@item.Telefono</td>
                                <td>@(item.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="badge text-bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (ViewContext.HttpContext.Request.Method == "POST")
{
    <div class="sg-card">
        <div class="card-body text-center text-muted py-5">
            No se encontraron pacientes con los filtros aplicados.
        </div>
    </div>
}
