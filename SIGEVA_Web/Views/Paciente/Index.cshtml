@model List<PacienteModel>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex justify-content-end mb-3 gap-2">
    <a asp-action="Reporte" class="btn btn-sg-outline">
        <i class="bi bi-file-earmark-bar-graph me-1"></i> Reporte
    </a>
    <a asp-action="Registrar" class="btn btn-sg">
        <i class="bi bi-plus-lg me-1"></i> Registrar paciente
    </a>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="sg-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Identificación</th>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Estado</th>
                            <th class="pe-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">@item.Identificacion</td>
                                <td>@item.Nombre</td>
                                <td>@item.Telefono</td>
                                <td>@item.Correo</td>
                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="badge text-bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <a asp-action="Editar" asp-route-id="@item.IdPaciente" class="btn btn-sm btn-sg-outline">Editar</a>
                                    <a asp-action="CambiarEstado"
                                       asp-route-id="@item.IdPaciente"
                                       asp-route-estado="@(!item.Estado)"
                                       class="btn btn-sm btn-outline-secondary">
                                        @(item.Estado ? "Desactivar" : "Activar")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="sg-card">
        <div class="card-body text-center text-muted py-5">
            No hay pacientes registrados.
        </div>
    </div>
}
