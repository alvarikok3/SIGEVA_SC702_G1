@model ReporteFiltroModel
@{
    ViewData["Title"] = "Reporte de mantenimientos";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Index" class="btn btn-sg-outline">Volver al listado</a>
</div>

<div class="sg-card mb-4">
    <div class="card-body">
        <h6 class="fw-semibold mb-3">Filtros</h6>
        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-@ViewBag.Tipo mb-3">@ViewBag.Mensaje</div>
        }
        <form asp-action="Reporte" method="post">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold" asp-for="FechaInicio">Fecha inicio</label>
                    <input type="date" name="FechaInicio" class="form-control"
                           value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" asp-for="FechaFin">Fecha fin</label>
                    <input type="date" name="FechaFin" class="form-control"
                           value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" asp-for="IdEquipo">Equipo</label>
                    <select asp-for="IdEquipo" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var e in Model.Equipos)
                        {
                            <option value="@e.IdEquipo">@e.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" asp-for="TipoMantenimiento">Tipo</label>
                    <select asp-for="TipoMantenimiento" class="form-select">
                        <option value="">Todos</option>
                        <option value="Preventivo">Preventivo</option>
                        <option value="Correctivo">Correctivo</option>
                        <option value="Predictivo">Predictivo</option>
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-sg">
                    <i class="bi bi-search me-1"></i> Generar reporte
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Resultados.Count > 0)
{
    <div class="sg-card">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                <span class="fw-semibold">@Model.Resultados.Count resultado(s)</span>
                <span class="fw-semibold">Total: &#8353;@Model.TotalCosto.ToString("N2")</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-3">Equipo</th>
                            <th>Tipo</th>
                            <th>Responsable</th>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Costo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Resultados)
                        {
                            <tr>
                                <td class="ps-3">@item.NombreEquipo</td>
                                <td>@item.TipoMantenimiento</td>
                                <td>@item.Responsable</td>
                                <td>@item.FechaMantenimiento.ToString("dd/MM/yyyy")</td>
                                <td>@item.Descripcion</td>
                                <td>&#8353;@item.Costo.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
