@{
    ViewData["Title"] = "Registrar usuario";
}

<div class="container-fluid">

    <div class="mb-3">
        <h2 class="mb-0">Registrar usuario</h2>
        <small class="text-muted">
            Complete la información del nuevo usuario.
        </small>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Mensaje
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="Usuario"
                  asp-action="Registrar"
                  method="post">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Identificación
                        </label>

                        <input type="text"
                               name="Identificacion"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Nombre completo
                        </label>

                        <input type="text"
                               name="Nombre"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Correo electrónico
                        </label>

                        <input type="email"
                               name="Correo"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Contraseña
                        </label>

                        <input type="password"
                               name="Contrasena"
                               class="form-control"
                               minlength="5"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Rol
                        </label>

                        <select name="IdRol"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione un rol
                            </option>

                            <option value="1">
                                Administrador
                            </option>

                            <option value="2">
                                Usuario
                            </option>

                        </select>
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Guardar usuario

                    </button>

                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>
    </div>

</div>